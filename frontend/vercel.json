{
    "buildCommand": "chmod +x node_modules/.bin/react-scripts && CI=false react-scripts build",
    "outputDirectory": "build",
    "installCommand": "npm install --legacy-peer-deps",
    "framework": "create-react-app",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}